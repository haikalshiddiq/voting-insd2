{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voting-insd2",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voting-insd2",
      "database_id": "8e8985c9-e61c-4324-9542-db1b6f6938c2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "ADMIN_EMAILS": "haikal.shiddiq@cakrawala.ac.id"
  }
}
